---
const {
  heading = 'Know where you stand.',
  body = 'Book a PQC Migration Readiness Assessment — fixed scope, fixed price, a board-ready roadmap in about three weeks.',
  button = 'Book a PQC Assessment',
  href = '/contact',
} = Astro.props;
---
<section class="ctaband">
  <div class="container ctaband__inner">
    <div>
      <h2 class="ctaband__h serif">{heading}</h2>
      <p class="ctaband__b">{body}</p>
    </div>
    <a href={href} class="btn btn--primary btn--lg ctaband__btn">{button}</a>
  </div>
</section>

<style>
  .ctaband {
    background:
      radial-gradient(130% 130% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--surface);
    border-block: 1px solid var(--line);
  }
  .ctaband__inner {
    display: flex; align-items: center; justify-content: space-between; gap: 32px;
    padding-block: clamp(40px, 6vw, 60px);
  }
  .ctaband__h { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 500; color: var(--ink); }
  .ctaband__b { color: var(--ink-2); margin-top: 10px; max-width: 52ch; }
  .ctaband__btn { flex: none; }
  @media (max-width: 720px) { .ctaband__inner { flex-direction: column; align-items: flex-start; } }
</style>
