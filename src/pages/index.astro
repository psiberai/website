---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Cta from '../components/Cta.astro';
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <span class="eyebrow">Post-quantum &amp; compliance readiness</span>
      <h1 class="hero__h">Post-quantum readiness,<br />made concrete.</h1>
      <p class="lead hero__lead">
        psiberAI maps where quantum breaks your cryptography and hands you a prioritized,
        board-ready plan to fix it — then keeps you audit-ready across ISO 27001 and ISO 42001.
        Vendor-neutral, standards-led.
      </p>
      <div class="wrap-btns hero__btns">
        <a href="/contact" class="btn btn--primary btn--lg">Book a PQC Assessment</a>
        <a href="/services" class="btn btn--ghost btn--lg">Explore services</a>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="section--tight trust">
    <div class="container trust__inner">
      <p class="trust__lead">Aligned to the standards that matter — and independent of every product that implements them.</p>
      <div class="trust__badges">
        <span class="badge">NIST FIPS 203 / 204 / 205</span>
        <span class="badge">ISO/IEC 27001</span>
        <span class="badge">ISO/IEC 42001</span>
        <span class="badge badge--accent">Vendor-neutral</span>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">What we do</span>
        <h2>Three ways we make security provable.</h2>
      </div>
      <div class="grid grid-3" style="margin-top:32px">
        <ServiceCard
          href="/services/pqc-migration"
          name="PQC Migration"
          tag="Post-quantum cryptography"
          featured={true}
          blurb="Find your quantum-vulnerable cryptography and get a phased migration roadmap — before 'harvest-now, decrypt-later' becomes 'decrypted.'"
        />
        <ServiceCard
          href="/services/iso-27001"
          name="ISO 27001"
          tag="Information security"
          blurb="Build or mature an information security management system that passes audit and reflects how you actually operate."
        />
        <ServiceCard
          href="/services/iso-42001"
          name="ISO 42001"
          tag="AI management"
          blurb="Govern your AI systems responsibly against the emerging AI-management standard — mapped to your real use cases."
        />
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- WHY NOW -->
  <section class="section whynow">
    <div class="container whynow__inner">
      <div>
        <span class="eyebrow">Why now</span>
        <h2 class="whynow__h">The clock is already running.</h2>
      </div>
      <div class="prose whynow__body">
        <p>
          Quantum computers will break the public-key cryptography — RSA, elliptic curve — that protects
          almost everything you send and store. Adversaries don't need to wait: they can
          <strong>capture your encrypted data today and decrypt it once the hardware arrives</strong>.
          Any secret with a shelf life measured in years is already exposed.
        </p>
        <p>
          NIST finalized the replacement algorithms — ML-KEM, ML-DSA and SLH-DSA — in 2024, and mandate
          timelines are converging on the early 2030s. The work is knowable now.
          <strong>But only if you can see where your cryptography actually lives</strong> — and most
          organizations have no inventory. That's where an assessment starts.
        </p>
      </div>
    </div>
  </section>

  <!-- FEATURED OFFER -->
  <section class="section offer">
    <div class="container">
      <div class="offer__card">
        <span class="badge badge--gold">Featured engagement</span>
        <h2 class="offer__h">PQC Migration Readiness Assessment</h2>
        <p class="offer__b">
          A fixed-scope, fixed-price engagement. In about three weeks you get a complete map of your
          cryptographic exposure, ranked by real-world risk, and a phased, costed roadmap to become
          quantum-safe — board-ready, vendor-neutral, and ready for your auditors.
        </p>
        <div class="offer__points">
          <div class="offer__pt"><span class="offer__k">01</span> Cryptographic inventory — where crypto lives, across your estate</div>
          <div class="offer__pt"><span class="offer__k">02</span> Quantum-risk heat map — ranked by harvest-now exposure</div>
          <div class="offer__pt"><span class="offer__k">03</span> Phased migration roadmap — quick wins, dependencies, cost</div>
        </div>
        <a href="/services/pqc-migration" class="btn btn--primary btn--lg" style="margin-top:8px">See the assessment</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- INSIGHTS TEASER -->
  <section class="section">
    <div class="container">
      <div class="sec-head sec-head--row">
        <div>
          <span class="eyebrow">Insights</span>
          <h2>Practical guidance on PQC &amp; compliance.</h2>
        </div>
        <a href="/insights" class="btn btn--ghost">All insights</a>
      </div>
      <div class="grid grid-3 insights" style="margin-top:32px">
        <article class="itease">
          <span class="itease__cat">PQC · Primer</span>
          <h3 class="itease__h">What "harvest-now, decrypt-later" actually means for your data</h3>
          <span class="itease__soon">Coming soon</span>
        </article>
        <article class="itease">
          <span class="itease__cat">PQC · How-to</span>
          <h3 class="itease__h">Building a cryptographic inventory: where to look first</h3>
          <span class="itease__soon">Coming soon</span>
        </article>
        <article class="itease">
          <span class="itease__cat">Compliance</span>
          <h3 class="itease__h">Crypto controls in ISO 27001 — and how PQC readiness feeds them</h3>
          <span class="itease__soon">Coming soon</span>
        </article>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- ABOUT SNIPPET -->
  <section class="section about">
    <div class="container about__inner">
      <span class="eyebrow">Independent by design</span>
      <p class="about__lead serif">
        psiberAI is an independent security and AI advisory. We don't resell products — so our
        assessments answer one question only: <em>what's genuinely best for you</em>.
      </p>
      <a href="/about" class="btn btn--ghost">About psiberAI</a>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .sec-head { max-width: 40ch; }
  .sec-head h2 { margin-top: 10px; }
  .sec-head--row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; max-width: none; }
  @media (max-width: 640px) { .sec-head--row { flex-direction: column; align-items: flex-start; } }

  /* hero */
  .hero {
    background:
      radial-gradient(120% 110% at 85% -10%, var(--accent-soft) 0%, transparent 46%);
    border-bottom: 1px solid var(--line);
  }
  .hero__inner { padding-block: clamp(56px, 11vw, 116px); }
  .hero__h { margin-top: 18px; font-size: clamp(2.3rem, 6.2vw, 4rem); }
  .hero__lead { margin-top: 22px; max-width: 58ch; }
  .hero__btns { margin-top: 30px; }

  /* trust */
  .trust__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .trust__lead { color: var(--ink-2); max-width: 44ch; font-size: .98rem; }
  .trust__badges { display: flex; flex-wrap: wrap; gap: 10px; }

  /* why now */
  .whynow__inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; }
  .whynow__h { margin-top: 12px; }
  @media (max-width: 820px) { .whynow__inner { grid-template-columns: 1fr; gap: 20px; } }

  /* offer */
  .offer__card {
    background:
      radial-gradient(130% 130% at 0% 0%, var(--gold-soft), transparent 55%),
      var(--surface);
    border: 1px solid color-mix(in srgb, var(--gold) 40%, var(--line));
    border-radius: 16px; padding: clamp(28px, 5vw, 48px); box-shadow: var(--shadow-lg);
  }
  .offer__h { margin-top: 14px; font-size: clamp(1.6rem, 3.4vw, 2.3rem); }
  .offer__b { color: var(--ink-2); margin-top: 16px; max-width: 64ch; }
  .offer__points { display: grid; gap: 12px; margin: 26px 0 28px; }
  .offer__pt { display: flex; gap: 14px; align-items: baseline; color: var(--ink); font-weight: 500; }
  .offer__k { font-family: var(--font-mono); color: var(--gold); font-weight: 600; font-size: .82rem; }

  /* insights teaser */
  .itease { display: flex; flex-direction: column; gap: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; box-shadow: var(--shadow); }
  .itease__cat { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--accent-2); }
  :root[data-theme="dark"] .itease__cat { color: var(--accent); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .itease__cat { color: var(--accent); } }
  .itease__h { font-size: 1.08rem; line-height: 1.35; flex: 1; }
  .itease__soon { font-family: var(--font-mono); font-size: .74rem; color: var(--ink-3); border: 1px dashed var(--line-2); border-radius: 6px; padding: 3px 9px; align-self: flex-start; }

  /* about */
  .about__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .about__lead { font-size: clamp(1.3rem, 2.8vw, 1.9rem); font-weight: 400; line-height: 1.4; color: var(--ink); max-width: 30ch; }
  .about__lead em { font-style: italic; color: var(--accent-2); }
  :root[data-theme="dark"] .about__lead em { color: var(--accent); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .about__lead em { color: var(--accent); } }
</style>
