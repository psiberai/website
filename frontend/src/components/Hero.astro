---
/**
 * Editorial, type-led hero. Copy is edited in Keystatic → src/content/home.json.
 */
import home from '../content/home.json';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">{home.heroEyebrow}</p>
    <h1 id="hero-title" class="hero__title">{home.heroTitle}</h1>
    <p class="lead hero__lead">{home.heroLead}</p>
    <div class="wrap-btns hero__btns">
      <a href="/contact" class="btn btn--primary btn--lg">{home.heroCtaPrimary}</a>
      <a href="#insights" class="btn btn--ghost btn--lg">{home.heroCtaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(120% 120% at 88% -15%, var(--accent-soft) 0%, transparent 46%);
  }
  .hero__inner { padding-block: clamp(56px, 12vw, 128px); max-width: 60rem; }
  .hero__eyebrow { margin-bottom: var(--sp-5); }
  .hero__title {
    font-size: clamp(2.2rem, 6.2vw, 4.1rem);
    letter-spacing: -.025em;
    max-width: 20ch;
  }
  .hero__lead { margin-top: var(--sp-5); max-width: 58ch; }
  .hero__btns { margin-top: var(--sp-6); }
</style>
