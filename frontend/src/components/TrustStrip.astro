---
/** Standards / credibility strip. Copy edited in Keystatic → src/content/home.json. */
import home from '../content/home.json';
---
<section class="trust section--tight" aria-label="Standards we work to">
  <div class="container trust__inner">
    <p class="trust__lead">{home.trustLead}</p>
    <ul class="trust__badges">
      {home.trustBadges.map((s) => <li class="badge">{s}</li>)}
      {home.trustAccentBadge && <li class="badge badge--accent">{home.trustAccentBadge}</li>}
    </ul>
  </div>
</section>

<style>
  .trust__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-5); flex-wrap: wrap; }
  .trust__lead { color: var(--ink-2); max-width: 44ch; font-size: .98rem; }
  .trust__badges { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
</style>
