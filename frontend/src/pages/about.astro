---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Cta from '../components/Cta.astro';
import { getEntry, render } from 'astro:content';

// Copy is edited in Keystatic → src/content/pages/about.md
const page = await getEntry('pages', 'about');
const { Content } = await render(page);
---
<Base
  title="About — psiberAI"
  description="psiberAI is an independent security and AI advisory for regulated enterprises — vendor-neutral, standards-led, focused on evidence over assertion."
>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.heading} lead={page.data.lead} />

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  <Cta />
</Base>
