---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry, render } from 'astro:content';

// Copy is edited in Keystatic → src/content/pages/privacy.md
const page = await getEntry('pages', 'privacy');
const { Content } = await render(page);
---
<Base
  title="Privacy Policy — psiberAI"
  description="How psiberAI collects, uses, and protects personal data."
>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.heading} lead={page.data.lead || undefined} />

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>
</Base>
