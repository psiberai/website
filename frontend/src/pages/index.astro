---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import InsightsFeed from '../components/InsightsFeed.astro';
import FeaturedOffer from '../components/FeaturedOffer.astro';
import ContactForm from '../components/ContactForm.astro';
import home from '../content/home.json';

const whyNowParas = home.whyNowBody.split(/\n\s*\n/).filter((p) => p.trim());
---
<Base>
  <Hero />
  <TrustStrip />

  <hr class="divider" />

  <!-- SERVICES -->
  <section class="section" aria-labelledby="svc-title">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow">{home.servicesEyebrow}</p>
        <h2 id="svc-title">{home.servicesHeading}</h2>
      </div>
      <div class="grid grid-3" style="margin-top:32px">
        {home.cards.map((c) => (
          <ServiceCard href={c.href} name={c.name} tag={c.tag} blurb={c.blurb} featured={c.featured} />
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- WHY NOW -->
  <section class="section whynow" aria-labelledby="why-title">
    <div class="container whynow__inner">
      <div>
        <p class="eyebrow">{home.whyNowEyebrow}</p>
        <h2 id="why-title" class="whynow__h">{home.whyNowHeading}</h2>
      </div>
      <div class="prose whynow__body">
        {whyNowParas.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <InsightsFeed />

  <FeaturedOffer />

  <hr class="divider" />

  <!-- ABOUT -->
  <section class="section about" aria-labelledby="about-title">
    <div class="container about__inner">
      <p class="eyebrow" id="about-title">{home.aboutEyebrow}</p>
      <p class="about__lead serif">{home.aboutLead}</p>
      <a href="/about" class="btn btn--ghost">{home.aboutButton}</a>
    </div>
  </section>

  <ContactForm />
</Base>

<style>
  .sec-head { max-width: 42ch; }
  .sec-head h2 { margin-top: var(--sp-3); }

  .whynow__inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 5vw, 48px); }
  .whynow__h { margin-top: var(--sp-3); }
  @media (max-width: 820px) { .whynow__inner { grid-template-columns: 1fr; gap: var(--sp-4); } }

  .about__inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-5); }
  .about__lead {
    font-size: clamp(1.3rem, 2.8vw, 1.9rem); font-weight: 400; line-height: 1.4;
    color: var(--ink); max-width: 30ch;
  }
  .about__lead em { font-style: italic; color: var(--accent-2); }
  :root[data-theme="dark"] .about__lead em { color: var(--accent); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .about__lead em { color: var(--accent); } }
</style>
