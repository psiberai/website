---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import InsightsFeed from '../components/InsightsFeed.astro';
import FeaturedOffer from '../components/FeaturedOffer.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Base>
  <Hero />
  <TrustStrip />

  <hr class="divider" />

  <!-- SERVICES -->
  <section class="section" aria-labelledby="svc-title">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow">What we do</p>
        <h2 id="svc-title">Three ways we make security provable.</h2>
      </div>
      <div class="grid grid-3" style="margin-top:32px">
        <ServiceCard
          href="/services/pqc-migration"
          name="PQC Migration"
          tag="Post-quantum cryptography"
          featured={true}
          blurb="Find your quantum-vulnerable cryptography and get a phased migration roadmap — before 'harvest-now, decrypt-later' becomes 'decrypted.'"
        />
        <ServiceCard
          href="/services/iso-27001"
          name="ISO 27001"
          tag="Information security"
          blurb="Build or mature an information security management system that passes audit and reflects how you actually operate."
        />
        <ServiceCard
          href="/services/iso-42001"
          name="ISO 42001"
          tag="AI management"
          blurb="Govern your AI systems against the emerging AI-management standard — mapped to your real use cases."
        />
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- WHY NOW -->
  <section class="section whynow" aria-labelledby="why-title">
    <div class="container whynow__inner">
      <div>
        <p class="eyebrow">Why now</p>
        <h2 id="why-title" class="whynow__h">The clock is already running.</h2>
      </div>
      <div class="prose whynow__body">
        <p>
          Quantum computers will break the public-key cryptography — RSA, elliptic curve — that protects
          almost everything you send and store. Adversaries don't need to wait: they can
          <strong>capture your encrypted data today and decrypt it once the hardware arrives</strong>.
          Any secret with a shelf life measured in years is already exposed.
        </p>
        <p>
          NIST finalized the replacement algorithms — ML-KEM, ML-DSA and SLH-DSA — in 2024, and mandate
          timelines are converging on the early 2030s. The work is knowable now —
          <strong>but only if you can see where your cryptography actually lives</strong>. That's where an
          assessment starts.
        </p>
      </div>
    </div>
  </section>

  <InsightsFeed />

  <FeaturedOffer />

  <hr class="divider" />

  <!-- ABOUT -->
  <section class="section about" aria-labelledby="about-title">
    <div class="container about__inner">
      <p class="eyebrow" id="about-title">Independent by design</p>
      <p class="about__lead serif">
        psiberAI is an independent security and AI advisory. We don't resell products — so our
        assessments answer one question only: <em>what's genuinely best for you</em>.
      </p>
      <a href="/about" class="btn btn--ghost">About psiberAI</a>
    </div>
  </section>

  <ContactForm />
</Base>

<style>
  .sec-head { max-width: 42ch; }
  .sec-head h2 { margin-top: var(--sp-3); }

  .whynow__inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 5vw, 48px); }
  .whynow__h { margin-top: var(--sp-3); }
  @media (max-width: 820px) { .whynow__inner { grid-template-columns: 1fr; gap: var(--sp-4); } }

  .about__inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-5); }
  .about__lead {
    font-size: clamp(1.3rem, 2.8vw, 1.9rem); font-weight: 400; line-height: 1.4;
    color: var(--ink); max-width: 30ch;
  }
  .about__lead em { font-style: italic; color: var(--accent-2); }
  :root[data-theme="dark"] .about__lead em { color: var(--accent); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .about__lead em { color: var(--accent); } }
</style>
