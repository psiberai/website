---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../data/insights.js';

const catLabel = Object.fromEntries(CATEGORIES.map((c) => [c.id, c.label]));
const posts = (await getCollection('insights', (e) => !e.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmtDate = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  title="Insights — psiberAI"
  description="Practical, vendor-neutral writing on post-quantum migration, cryptographic inventory, and compliance for regulated enterprises."
>
  <PageHeader
    eyebrow="Insights"
    title="Writing on PQC and compliance."
    lead="Practical, vendor-neutral notes on post-quantum migration and the compliance work around it — no hype, no vendor pitch."
  />

  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <ul class="plist">
          {posts.map((p) => (
            <li class="pcard">
              <a href={`/insights/${p.id}`} class="pcard__link">
                <span class="pcard__cat mono">{catLabel[p.data.category]}</span>
                <h2 class="pcard__h">{p.data.title}</h2>
                <p class="pcard__note">{p.data.description}</p>
                <span class="pcard__meta mono">{fmtDate(p.data.pubDate)}{p.data.readMinutes ? ` · ${p.data.readMinutes} min read` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="plist__soon muted">
          The first articles are publishing shortly.
          <a href="/contact">Ask to be notified</a> when they land.
        </p>
      )}
    </div>
  </section>

  <Cta />
</Base>

<style>
  .plist { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-width: 60rem; }
  .pcard { border-top: 1px solid var(--line); }
  .pcard:last-child { border-bottom: 1px solid var(--line); }
  .pcard__link { display: block; padding: var(--sp-5) 0; color: var(--ink); }
  .pcard__link:hover { text-decoration: none; }
  .pcard__link:hover .pcard__h { color: var(--accent-2); }
  :root[data-theme="dark"] .pcard__link:hover .pcard__h { color: var(--accent); }
  .pcard__cat { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .pcard__h { font-size: 1.22rem; line-height: 1.32; margin-top: 6px; transition: color .15s ease; }
  .pcard__note { color: var(--ink-2); font-size: .95rem; margin-top: 8px; max-width: 68ch; }
  .pcard__meta { display: block; margin-top: 10px; font-size: .78rem; color: var(--ink-3); }
  .plist__soon { font-size: 1.02rem; }
</style>
