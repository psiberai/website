---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import svc from '../../content/services-index.json';
---
<Base title="Services — psiberAI" description="PQC migration, ISO 27001, and ISO 42001 — vendor-neutral security and AI-governance advisory for regulated enterprises.">
  <PageHeader eyebrow={svc.eyebrow} title={svc.heading} lead={svc.lead} />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {svc.cards.map((c) => (
          <ServiceCard href={c.href} name={c.name} tag={c.tag} blurb={c.blurb} featured={c.featured} />
        ))}
      </div>

      <div class="services-note">
        <p>{svc.note}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .services-note {
    margin-top: 40px;
    padding: clamp(20px, 3vw, 28px) clamp(22px, 3.5vw, 32px);
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent-2);
    border-radius: var(--radius);
  }
  .services-note p {
    margin: 0;
    max-width: none;
    color: var(--ink-2);
    line-height: 1.65;
  }
</style>
