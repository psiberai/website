---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import page from '../../content/pqc-migration.json';

const problemParas = page.problemBody.split(/\n\s*\n/);
---
<Base
  title="PQC Migration Readiness Assessment — psiberAI"
  description="A fixed-scope, fixed-price assessment that maps your cryptographic exposure to quantum and delivers a board-ready migration roadmap in about three weeks. Vendor-neutral."
>
  <PageHeader eyebrow={page.eyebrow} title={page.title} lead={page.lead} />

  <!-- problem -->
  <section class="section">
    <div class="container two-col">
      <div>
        <span class="eyebrow">{page.problemEyebrow}</span>
        <h2 style="margin-top:12px">{page.problemHeading}</h2>
      </div>
      <div class="prose">
        {problemParas.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- method -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{page.methodEyebrow}</span>
        <h2>{page.methodHeading}</h2>
      </div>
      <ol class="method">
        {page.method.map((m, i) => (
          <li class="mstep">
            <span class="mstep__n">{String(i + 1)}</span>
            <div>
              <h3 class="mstep__h"><span class="mstep__verb">{m.verb}</span> {m.name}</h3>
              <p class="mstep__b">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="divider" />

  <!-- deliverables -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{page.deliverablesEyebrow}</span>
        <h2>{page.deliverablesHeading}</h2>
      </div>
      <div class="grid grid-3 delivs" style="margin-top:30px">
        {page.deliverables.map((d) => (
          <div class="deliv">
            <h3 class="deliv__t">{d.title}</h3>
            <p class="deliv__b">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- tiers -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{page.tiersEyebrow}</span>
        <h2>{page.tiersHeading}</h2>
      </div>
      <div class="grid grid-3 tiers" style="margin-top:30px">
        {page.tiers.map((t) => (
          <div class={t.featured ? 'tier tier--feat' : 'tier'}>
            {t.flag && <span class="tier__flag mono">{t.flag}</span>}
            <span class="tier__k mono">{t.key}</span>
            <h3>{t.name}</h3>
            <p class="tier__meta mono">{t.meta}</p>
            <p class="tier__b">{t.body}</p>
          </div>
        ))}
      </div>
      <p class="faint" style="margin-top:18px; font-size:.9rem">{page.tiersNote} <a href="/contact">Talk to us</a> about sizing for your estate.</p>
    </div>
  </section>

  <Cta heading={page.ctaHeading} body={page.ctaBody} />
</Base>

<style>
  .two-col { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; }
  @media (max-width: 820px) { .two-col { grid-template-columns: 1fr; gap: 18px; } }
  .sec-head { max-width: 44ch; }
  .sec-head h2 { margin-top: 10px; }

  .method { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .mstep { display: grid; grid-template-columns: 46px 1fr; gap: 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 22px; box-shadow: var(--shadow); }
  .mstep__n { font-family: var(--font-mono); font-weight: 600; color: var(--accent-2); border: 1.5px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 9px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--accent-soft); }
  :root[data-theme="dark"] .mstep__n { color: var(--accent); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .mstep__n { color: var(--accent); } }
  .mstep__h { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .mstep__verb { font-family: var(--font-mono); font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: var(--purple); }
  .mstep__b { color: var(--ink-2); margin-top: 5px; font-size: .96rem; }

  .deliv { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; box-shadow: var(--shadow); }
  .deliv__t { font-size: 1.05rem; }
  .deliv__b { color: var(--ink-2); margin-top: 7px; font-size: .92rem; }

  .tier { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); position: relative; display: flex; flex-direction: column; gap: 8px; }
  .tier--feat { border-color: color-mix(in srgb, var(--purple) 50%, transparent); box-shadow: 0 0 0 3px var(--purple-soft), var(--shadow); }
  .tier__flag { position: absolute; top: -11px; left: 20px; background: var(--purple); color: #fff; font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; padding: 3px 10px; border-radius: 6px; font-weight: 600; }
  :root[data-theme="dark"] .tier__flag { color: #0D1117; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .tier__flag { color: #0D1117; } }
  .tier__k { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .tier__meta { font-size: .82rem; color: var(--accent-2); }
  :root[data-theme="dark"] .tier__meta { color: var(--accent); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .tier__meta { color: var(--accent); } }
  .tier__b { color: var(--ink-2); font-size: .93rem; }
</style>
