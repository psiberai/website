---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import { getEntry, render } from 'astro:content';

// Copy is edited in Keystatic → src/content/pages/iso-42001.md
const page = await getEntry('pages', 'iso-42001');
const { Content } = await render(page);
---
<Base
  title="ISO 42001 — psiberAI"
  description="Stand up responsible AI governance against ISO/IEC 42001, the AI-management-system standard — mapped to your real AI use cases. Vendor-neutral."
>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.heading} lead={page.data.lead} />

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  <Cta
    heading={page.data.ctaHeading || undefined}
    body={page.data.ctaBody || undefined}
    button={page.data.ctaButton || undefined}
  />
</Base>
