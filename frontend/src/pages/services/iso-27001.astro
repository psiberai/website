---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import { getEntry, render } from 'astro:content';

// Copy is edited in Keystatic → src/content/pages/iso-27001.md
const page = await getEntry('pages', 'iso-27001');
const { Content } = await render(page);
---
<Base
  title="ISO 27001 — psiberAI"
  description="Build or mature an ISO/IEC 27001 information security management system that passes audit and reflects how you actually operate. Vendor-neutral."
>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.heading} lead={page.data.lead} />

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  <Cta
    heading={page.data.ctaHeading || undefined}
    body={page.data.ctaBody || undefined}
    button={page.data.ctaButton || undefined}
  />
</Base>
